# Copy to .env and fill in values. Only VITE_* variables are exposed to the
# frontend via import.meta.env (see src/config.ts and src/vite-env.d.ts).

# Backend base URL used when no remote backend is configured in Settings.
VITE_API_BASE_URL="http://127.0.0.1:4132"

# Default backend API key (optional; overrides the Settings remote key).
VITE_API_KEY=""

# Local provider keys below are OPTIONAL — keys can also be entered in the
# SetupWizard or Settings UI (password-protected). Values here are baked in
# at build time; prefer the Settings vault for secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
