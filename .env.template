# ==========================================
# Meridian-X Template Environment Configuration
# Copy this file to '.env' and fill in your keys
# ==========================================

# --- Local & Infrastructure Services ---
OLLAMA_HOST=http://127.0.0.1:11434
MONGODB_URI=mongodb://localhost:27017/meridian_kg
FORWARDED_ALLOW_IPS=127.0.0.1
WEB_CONCURRENCY=1
LSP_HOST=127.0.0.1
LSP_PORT=2087

# --- Authentication & API Security ---
MERIDIAN_API_KEY=
VITE_API_KEY=
DISABLE_AUTH=false
MERIDIAN_BIND_HOST=127.0.0.1
MERIDIAN_WEBHOOK_SECRET=
MERIDIAN_VAULT_KEY=
MERIDIAN_VAULT_PASSPHRASE=
P2P_SECRET_TOKEN=
OAUTH_JWT_SECRET=
MERIDIAN_ALLOW_HOST_CODE_EXEC=false

# --- LLM Provider & Model Configuration ---
# Active provider: ollama (local), openai, anthropic, gemini, deepseek, groq, openrouter, mistral, custom
MERIDIAN_PROVIDER=ollama
MERIDIAN_MODEL_SOURCE=local

# Core Brain model name used for general logic, planning, and code writing
MERIDIAN_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
MERIDIAN_FAST_MODEL=
MERIDIAN_AUDITOR_MODEL=qwen2.5-coder:1.5b-instruct-q8_0
MERIDIAN_VISION_MODEL=moondream:1.8b
EMBEDDING_MODEL=nomic-embed-text

# Cloud API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_BASE_URL=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Custom Open-AI Compatible Endpoint Config
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=

# --- Third-Party Integrations & Connectors ---
TAVILY_API_KEY=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_ID=
OIDC_AUTH_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=

# Email / Communication Setup
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
IMAP_SERVER=imap.gmail.com

# Bot & Messaging Bridges
DISCORD_BOT_TOKEN=
MERIDIAN_ALLOWED_DISCORD_IDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_AUTHORIZED_CHAT_ID=
MERIDIAN_ALLOWED_TELEGRAM_IDS=

# --- System Resources & Performance ---
MERIDIAN_DATA_DIR=
MERIDIAN_CPU_THROTTLE_PCT=100
MERIDIAN_GPU_THROTTLE_PCT=100
CPU_WARN_THRESHOLD=85.0
RAM_WARN_THRESHOLD=88.0
DISK_WARN_THRESHOLD=90.0
DISTRACTION_SITES=['facebook.com', 'instagram.com', 'youtube.com', 'twitter.com', 'reddit.com']
USER_LOCATION_CITY=

# Browser & UI Automation
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800

# --- Voice & Audio Subsystem ---
MERIDIAN_VOICE=M1
WAKEWORD_THRESHOLD=0.6
WAKEWORD_MODEL_FILENAME=hey_meridian.onnx
WAKEWORD_PHRASE=Hey Meridian
STT_MODEL_SIZE=base
STT_SILENCE_TIMEOUT=1.0
STT_VAD_THRESHOLD=300.0
STT_MAX_DURATION=8.0

# --- Diagnostics & Logging ---
MERIDIAN_LOG_LEVEL=INFO
MERIDIAN_LOG_JSON=false
PYDANTIC_DISABLE_PLUGINS=true
PYDANTIC_PRIVATE_ALLOW_UNHANDLED_SCHEMA_TYPES=true
