# Meridian-X Full Production Turnkey Caddy Gateway
# Serves React/Vite Frontend Single Page Application and proxies API & WebSockets.
# Replace domain or pass DOMAIN=yourdomain.com in environment.

{$DOMAIN:localhost} {
	encode zstd gzip

	# Healthcheck & API / WebSocket Endpoints
	@api {
		path /api/* /ws/* /health /docs /openapi.json
	}
	handle @api {
		reverse_proxy meridian-backend:4132 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Frontend Static Single Page Application
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
